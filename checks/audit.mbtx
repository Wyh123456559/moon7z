----
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
async fn main {
  let target = @env.args().get(1).unwrap_or("wasm")
  guard target == "wasm" || target == "native" else {
    fail("expected wasm or native")
  }
  let args = ["run", "--target", target, "app", "--", "audit", "--json"]
  let intact = @shell.Cmd("moon", args + ["corpus/copy-plain.7z"]).output(
    timeout_ms=120000,
  )
  assert_eq(intact.exit_code(), 0)
  assert_true(
    @json.parse(intact.stdout())
    is {
      "schema": String("moon7z.audit.v1"),
      "all_available_checks_passed": True,
      ..
    },
  )
  let root = @fs.tmpdir(prefix="moon7z-audit")
  defer @fs.rmdir(root, recursive=true)
  let bytes = @fs.read_file("corpus/copy-plain.7z").binary().to_array()
  bytes[32] = (bytes[32].to_int() ^ 1).to_byte()
  let path = root + "/damaged.7z"
  @fs.write_file(path, Bytes::from_array(bytes))
  let damaged = @shell.Cmd("moon", args + [path]).output(timeout_ms=120000)
  assert_eq(damaged.exit_code(), 0)
  assert_true(
    @json.parse(damaged.stdout())
    is {
      "all_available_checks_passed": False,
      "folders": Array(
        [
          {
            "status": String("failed"),
            "error": { "code": String("checksum"), .. },
            ..
          },
          { "status": String("passed"), .. },
          _,
          _,
        ]
      ),
      ..
    },
  )
  let strict = @shell.Cmd("moon", [
    "run", "--target", target, "app", "--", "test", path,
  ]).output(timeout_ms=120000)
  assert_true(strict.exit_code() != 0)
  assert_true(strict.stdout().is_empty())
  for input in ["corpus/copy-plain.7z", path] {
    let positioned = @shell.Cmd("moon", [
      "run", "--target", target, "app", "--", "source-audit", "--json", input,
    ]).output(timeout_ms=120000)
    assert_eq(positioned.exit_code(), 0)
    let memory = @shell.Cmd("moon", args + [input]).output(timeout_ms=120000)
    let actual = @json.parse(positioned.stdout())
    let expected = @json.parse(memory.stdout())
    if input == path {
      assert_true(
        actual
        is {
          "all_available_checks_passed": False,
          "folders": Array(
            [
              { "status": String("failed"), .. },
              { "status": String("passed"), .. },
              _,
              _,
            ]
          ),
          ..
        },
      )
    } else {
      assert_eq(actual, expected)
    }
  }
  let split = @shell.Cmd("moon", [
    "run", "--target", target, "app", "--", "source-volumes-audit", "--json", "corpus/volumes/fixed/package.7z.001",
    "corpus/volumes/fixed/package.7z.002", "corpus/volumes/fixed/package.7z.003",
  ]).output(timeout_ms=120000)
  assert_eq(split.exit_code(), 0)
  assert_true(
    @json.parse(split.stdout()) is { "all_available_checks_passed": True, .. },
  )
  @fs.write_file(root + "/truncated.7z", b"7z")
  let bad_header = @shell.Cmd("moon", args + [root + "/truncated.7z"]).output(
    timeout_ms=120000,
  )
  assert_true(bad_header.exit_code() != 0)
  assert_true(bad_header.stdout().is_empty())
  println(
    "Audits isolate corrupt folders and retain typed diagnostics while strict verification still fails",
  )
}
