///|
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  let target = @env.args().get(1).unwrap_or("wasm")
  guard ["wasm", "wasm-gc", "js", "native"].contains(target) else {
    fail("expected a stable MoonBit target")
  }
  for
    command in [
      ["fmt", "--check"],
      ["info"],
      ["check", "--target", target, "--deny-warn"],
      ["test", "--target", target, "--deny-warn"],
    ] {
    @shell.Cmd("moon", command).run(timeout_ms=120000)
  }
  @shell.Cmd("git", ["diff", "--exit-code", "--", "*.mbti"]).run()
  if target == "wasm" || target == "native" {
    for path in ["copy-plain", "lzma-solid", "lzma2-solid", "lzma2-separate"] {
      @shell.Cmd("moon", [
        "run",
        "--target",
        target,
        "app",
        "--",
        "test",
        "corpus/" + path + ".7z",
      ]).run(timeout_ms=120000)
    }
    @shell.Cmd("moon", [
      "run", "--target", target, "examples/import", "--", "corpus/lzma2-solid.7z",
    ]).run(timeout_ms=120000)
  }
}
