----
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}
----

///|
async fn main {
  let target = @env.args().get(1).unwrap_or("wasm")
  guard ["wasm", "wasm-gc", "js", "native"].contains(target) else {
    fail("expected a stable MoonBit target")
  }
  for
    command in [
      ["fmt", "--check"],
      ["fmt", "--check", "checks/verify.mbtx"],
      ["fmt", "--check", "checks/export.mbtx"],
      ["fmt", "--check", "checks/select.mbtx"],
      ["fmt", "--check", "checks/filters.mbtx"],
      ["fmt", "--check", "checks/ranges.mbtx"],
      ["fmt", "--check", "checks/integrity.mbtx"],
      ["fmt", "--check", "checks/reports.mbtx"],
      ["fmt", "--check", "checks/subset.mbtx"],
      ["fmt", "--check", "checks/batch-ranges.mbtx"],
      ["fmt", "--check", "checks/compare.mbtx"],
      ["fmt", "--check", "checks/audit.mbtx"],
      ["fmt", "--check", "checks/incremental-export.mbtx"],
      ["fmt", "--check", "checks/branches.mbtx"],
      ["fmt", "--check", "checks/properties.mbtx"],
      ["fmt", "--check", "checks/producers.mbtx"],
      ["fmt", "--check", "checks/bcj2.mbtx"],
      ["fmt", "--check", "checks/deflate.mbtx"],
      ["fmt", "--check", "checks/bzip2.mbtx"],
      ["fmt", "--check", "checks/encrypted.mbtx"],
      ["fmt", "--check", "checks/riscv.mbtx"],
      ["fmt", "--check", "checks/external.mbtx"],
      ["fmt", "--check", "checks/semantics.mbtx"],
      ["fmt", "--check", "checks/ppmd.mbtx"],
      ["fmt", "--check", "checks/lzma1.mbtx"],
      ["fmt", "--check", "checks/sfx.mbtx"],
      ["fmt", "--check", "checks/volumes.mbtx"],
      ["fmt", "--check", "checks/source.mbtx"],
      ["fmt", "--check", "checks/source-sfx.mbtx"],
      ["fmt", "--check", "checks/source-select.mbtx"],
      ["fmt", "--check", "checks/source-compare.mbtx"],
      ["fmt", "--check", "corpus/sfx/materialize-large.mbtx"],
      ["fmt", "--check", "corpus/source64/generate.mbtx"],
      ["fmt", "--check", "corpus/source64/materialize.mbtx"],
      ["fmt", "--check", "corpus/volumes/generate.mbtx"],
      ["fmt", "--check", "corpus/sfx/generate.mbtx"],
      ["fmt", "--check", "corpus/lzma1/generate.mbtx"],
      ["fmt", "--check", "corpus/ppmd/generate.mbtx"],
      ["fmt", "--check", "corpus/semantics/generate.mbtx"],
      ["fmt", "--check", "corpus/external/generate.mbtx"],
      ["fmt", "--check", "corpus/riscv/generate.mbtx"],
      ["fmt", "--check", "corpus/encrypted/generate.mbtx"],
      ["fmt", "--check", "corpus/bzip2/generate.mbtx"],
      ["fmt", "--check", "corpus/deflate/generate.mbtx"],
      ["fmt", "--check", "corpus/bcj2/generate.mbtx"],
      ["fmt", "--check", "corpus/branches/generate.mbtx"],
      ["fmt", "--check", "corpus/properties/generate.mbtx"],
      ["fmt", "--check", "corpus/producers/generate.mbtx"],
      ["fmt", "--check", "corpus/audio/generate.mbtx"],
      ["fmt", "--check", "corpus/x86/generate.mbtx"],
      ["fmt", "--check", "corpus/arm64/generate.mbtx"],
      ["info"],
      ["check", "--target", target, "--deny-warn", "-j", "2"],
      ["build", "--target", target, "--deny-warn", "-j", "2"],
      ["test", "--target", target, "--deny-warn", "-j", "2"],
    ] {
    @shell.Cmd("moon", command).run(timeout_ms=120000)
  }
  @shell.Cmd("git", ["diff", "--exit-code", "--", "*.mbti"]).run()
  if target == "wasm" || target == "native" {
    @shell.Cmd("moon", ["run", "checks/source-compare.mbtx", "--", target]).run(
      timeout_ms=240000,
    )
    @shell.Cmd("moon", ["run", "checks/source-select.mbtx", "--", target]).run(
      timeout_ms=240000,
    )
    @shell.Cmd("moon", ["run", "checks/source-sfx.mbtx", "--", target]).run(
      timeout_ms=900000,
    )
    @shell.Cmd("moon", ["run", "checks/source.mbtx", "--", target]).run(
      timeout_ms=900000,
    )
    @shell.Cmd("moon", ["run", "checks/volumes.mbtx", "--", target]).run(
      timeout_ms=900000,
    )
    @shell.Cmd("moon", ["run", "checks/sfx.mbtx", "--", target]).run(
      timeout_ms=600000,
    )
    @shell.Cmd("moon", ["run", "checks/lzma1.mbtx", "--", target]).run(
      timeout_ms=360000,
    )
    @shell.Cmd("moon", ["run", "checks/ppmd.mbtx", "--", target]).run(
      timeout_ms=360000,
    )
    @shell.Cmd("moon", ["run", "checks/semantics.mbtx", "--", target]).run(
      timeout_ms=480000,
    )
    @shell.Cmd("moon", ["run", "checks/external.mbtx", "--", target]).run(
      timeout_ms=240000,
    )
    @shell.Cmd("moon", ["run", "checks/riscv.mbtx", "--", target]).run(
      timeout_ms=240000,
    )
    @shell.Cmd("moon", ["run", "checks/encrypted.mbtx", "--", target]).run(
      timeout_ms=360000,
    )
    @shell.Cmd("moon", ["run", "checks/bzip2.mbtx", "--", target]).run(
      timeout_ms=240000,
    )
    @shell.Cmd("moon", ["run", "checks/deflate.mbtx", "--", target]).run(
      timeout_ms=240000,
    )
    @shell.Cmd("moon", ["run", "checks/bcj2.mbtx", "--", target]).run(
      timeout_ms=240000,
    )
    @shell.Cmd("moon", ["run", "checks/producers.mbtx", "--", target]).run(
      timeout_ms=600000,
    )
    @shell.Cmd("moon", ["run", "checks/properties.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/branches.mbtx", "--", target]).run(
      timeout_ms=360000,
    )
    @shell.Cmd("moon", ["run", "checks/incremental-export.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/audit.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/compare.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/batch-ranges.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/subset.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/reports.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/integrity.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/ranges.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/filters.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/select.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    @shell.Cmd("moon", ["run", "checks/export.mbtx", "--", target]).run(
      timeout_ms=120000,
    )
    for path in ["copy-plain", "lzma-solid", "lzma2-solid", "lzma2-separate"] {
      @shell.Cmd("moon", [
        "run",
        "--target",
        target,
        "app",
        "--",
        "test",
        "corpus/" + path + ".7z",
      ]).run(timeout_ms=120000)
    }
    @shell.Cmd("moon", [
      "run", "--target", target, "examples/import", "--", "corpus/lzma2-solid.7z",
    ]).run(timeout_ms=120000)
  }
}
